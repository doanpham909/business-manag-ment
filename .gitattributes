# Chuẩn hóa xuống dòng: lưu LF trong repo, Git tự xử lý khi checkout
* text=auto eol=lf

# Script Windows giữ CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# File nhị phân
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary
